<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d0d0d">

    <!-- 상단 바: 제목 + 계정 전환 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#161616">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N AutoCL"
            android:textColor="#e0e0e0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/accountGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcc1"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dicajohn"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcc2"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="macdcross"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:textColor="#7c6ff7"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 디버그 로그(포스팅 중에도 보임): 세로로 작게(접기 가능) -->
    <TextView
        android:id="@+id/debugLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="#0a0a0a"
        android:fontFamily="monospace"
        android:textColor="#5fae5f"
        android:textSize="8sp"
        android:maxLines="3"
        android:scrollbars="vertical"
        android:visibility="gone" />

    <!-- 포스팅 중 상단 도구바: 접기/펼치기 + 사용법(포스팅 중에만 표시) -->
    <LinearLayout
        android:id="@+id/postBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#121212"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <Button android:id="@+id/btnCollapseChrome"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minWidth="0dp"
            android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:text="▾ 입력도구·로그 접기" android:textSize="11sp" />

        <Button android:id="@+id/btnGuide"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp" android:minWidth="0dp"
            android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:text="❓ 사용법(복사·붙여넣기)" android:textSize="11sp" />
    </LinearLayout>

    <!-- 홈 화면 빠른 이동: 폼이 길어서 맨 위/맨 아래로 점프 -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#121212"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button android:id="@+id/btnScrollTop"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minWidth="0dp"
            android:text="▲ 맨 위" android:textSize="12sp" />

        <Button android:id="@+id/btnScrollBottom"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp" android:minWidth="0dp"
            android:text="▼ 맨 아래" android:textSize="12sp" />
    </LinearLayout>

    <!-- 수동 입력 바: 자동 입력 실패 대비(포스팅 중에만 표시).
         각 줄 = [에디터에 직접 입력] · [클립보드 복사] · [에디터에 붙여넣기 추가] -->
    <LinearLayout
        android:id="@+id/manualBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1a1320"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <!-- 제목 줄 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnFillTitle"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minWidth="0dp"
                android:text="제목 입력" android:textSize="11sp"
                android:paddingStart="2dp" android:paddingEnd="2dp" />

            <Button android:id="@+id/btnTitleCopy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="4dp" android:minWidth="0dp"
                android:text="제목 복사" android:textSize="11sp"
                android:paddingStart="2dp" android:paddingEnd="2dp" />

            <Button android:id="@+id/btnTitlePaste"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="4dp" android:minWidth="0dp"
                android:text="제목 붙여넣기" android:textSize="11sp"
                android:paddingStart="2dp" android:paddingEnd="2dp" />
        </LinearLayout>

        <!-- 내용 줄 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button android:id="@+id/btnFillBody"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minWidth="0dp"
                android:text="내용 입력" android:textSize="11sp"
                android:paddingStart="2dp" android:paddingEnd="2dp" />

            <Button android:id="@+id/btnBodyCopy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="4dp" android:minWidth="0dp"
                android:text="내용 복사" android:textSize="11sp"
                android:paddingStart="2dp" android:paddingEnd="2dp" />

            <Button android:id="@+id/btnBodyPaste"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="4dp" android:minWidth="0dp"
                android:text="내용 붙여넣기" android:textSize="11sp"
                android:paddingStart="2dp" android:paddingEnd="2dp" />
        </LinearLayout>

        <!-- 사진 줄 -->
        <Button android:id="@+id/btnFillPhoto"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:minWidth="0dp"
            android:text="🖼 사진 입력(파일 선택창)" android:textSize="11sp"
            android:paddingStart="2dp" android:paddingEnd="2dp" />
    </LinearLayout>

    <!-- 본문 영역: 입력 폼 / 포스팅용 WebView 가 번갈아 표시 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/form"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="제목 (자동 생성 · 수정 가능)"
                        android:textColor="#9a9a9a"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCopyTitleHome"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="📋 복사"
                        android:textSize="11sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/titleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="본문을 입력하면 자동 생성됩니다"
                    android:textColor="#f0f0f0"
                    android:textColorHint="#5a5a5a"
                    android:textSize="14sp"
                    android:background="#1c1c1c"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"
                    android:inputType="textMultiLine"
                    android:maxLines="3" />

                <Button
                    android:id="@+id/btnGenTitle"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="↻ 제목 자동생성"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="본문 — 전체 글을 붙여넣으세요"
                    android:textColor="#9a9a9a"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/contentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="제목줄\n\n첫 문단...\n\n...\n\n마지막 요약줄"
                    android:textColor="#f0f0f0"
                    android:textColorHint="#5a5a5a"
                    android:textSize="14sp"
                    android:background="#1c1c1c"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:minLines="5"
                    android:maxLines="5"
                    android:scrollbars="vertical"
                    android:overScrollMode="always"
                    android:inputType="textMultiLine|textCapSentences" />

                <!-- 서식 미리보기 1: 간단(볼드) — 소제목·주요 단어만 굵게 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="✏️ 간단 서식 미리보기 (소제목·주요 단어 볼드)"
                    android:textColor="#9a9a9a"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/previewBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1c1c1c"
                    android:padding="10dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="#f0f0f0"
                    android:textSize="14sp"
                    android:maxLines="5"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:text="본문을 입력하면 여기에 미리보기가 표시됩니다" />

                <Button
                    android:id="@+id/btnCopyBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="📋 간단 서식 복사 (볼드)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#5b7cfa"
                    android:textColor="#ffffff" />

                <!-- 서식 미리보기 2: 강조 — 색상·하이라이트·볼드(네이버 붙여넣기용) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="🎨 강조 서식 미리보기 (색상·하이라이트·볼드)"
                    android:textColor="#9a9a9a"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/previewRich"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#ffffff"
                    android:padding="10dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:maxLines="5"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:text="본문을 입력하면 여기에 강조 미리보기가 표시됩니다" />

                <Button
                    android:id="@+id/btnCopyRich"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="📋 강조 서식 복사 (네이버 붙여넣기용)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#03c75a"
                    android:textColor="#ffffff" />

                <!-- 사진 선택 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnPickPhotos"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖼 사진 선택"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/photoCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="선택된 사진 없음"
                        android:textColor="#9a9a9a"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnClearPhotos"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="비우기"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/photoStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- 발행 자동/수동 -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoPublishSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="발행까지 자동 (끄면 검토 후 직접 발행)"
                    android:textColor="#cfcfcf"
                    android:textSize="12sp"
                    android:checked="false" />

                <!-- 포스팅 버튼 -->
                <Button
                    android:id="@+id/btnPost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="📤 블로그 포스팅"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#03c75a"
                    android:textColor="#ffffff" />

                <!-- 블로그 앱으로 작성 (복사 → 붙여넣기) : 웹뷰 입력이 안 될 때 우회 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="📱 블로그 앱으로 작성 (복사 → 붙여넣기)"
                    android:textColor="#03c75a"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="① 제목 복사 → 앱 제목칸에 붙여넣기  ②본문 복사(서식) → 본문칸에 붙여넣기"
                    android:textColor="#7a7a7a"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btnCopyTitleApp"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="① 제목 복사"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCopyBodyApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:text="② 본문 복사(서식)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="#03c75a"
                        android:textColor="#ffffff" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOpenBlogApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="📱 네이버 블로그 앱 열기"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#03c75a"
                    android:textColor="#ffffff" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#2a2a2a" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="SNS 공유 (포스팅 완료 후)"
                    android:textColor="#9a9a9a"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/postedUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="아직 게시된 글이 없습니다"
                    android:textColor="#5a5a5a"
                    android:textSize="11sp"
                    android:autoLink="web" />

                <!-- 공유 원문: 포스팅 후 자동 생성(제목+모바일URL) · 네이버 '공유하기 복사' 붙여넣기/수정 가능 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="공유 원문 (자동 생성 · 붙여넣기/수정 가능)"
                    android:textColor="#9a9a9a"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/snsInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="포스팅 완료 후 자동 생성됩니다.\n네이버 '공유하기 복사' 글을 붙여넣어도 됩니다."
                    android:textColor="#f0f0f0"
                    android:textColorHint="#5a5a5a"
                    android:textSize="13sp"
                    android:background="#1c1c1c"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:minLines="3"
                    android:maxLines="6"
                    android:scrollbars="vertical"
                    android:inputType="textMultiLine" />

                <!-- 후킹 메시지: 원문/제목/URL 바뀌면 자동 변환(블록 줄바꿈 + CTA + URL) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="후킹 메시지 (자동 변환 · 복사용)"
                    android:textColor="#9a9a9a"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/hookOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="공유 원문을 넣으면 후킹 문구로 자동 변환됩니다."
                    android:textColor="#ffe27a"
                    android:textColorHint="#5a5a5a"
                    android:textSize="13sp"
                    android:background="#15140b"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:minLines="6"
                    android:maxLines="14"
                    android:scrollbars="vertical"
                    android:inputType="textMultiLine" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btnGenHook"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="↻ 다시 생성"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCopyHook"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:text="📋 후킹 복사"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="#7c6ff7"
                        android:textColor="#ffffff" />
                </LinearLayout>

                <!-- SNS별 개별 복사: 앱마다 형식이 달라 카드를 따로 생성(코드에서 동적 구성) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="SNS별 개별 복사 (앱마다 형식 다름 · 복사 후 앱 열기)"
                    android:textColor="#9a9a9a"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/snsCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>
        </ScrollView>

        <!-- 포스팅용 WebView (포스팅 중에만 보임) -->
        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
